{
  "name": "@th/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=../../.env src/scripts/bootstrapAdmin.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "@th/shared": "*",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "file-type": "^22.1.1",
    "heic-decode": "^2.1.0",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
