# Éles környezetben a valódi értékeket kötelező megváltoztatni.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://th:th@localhost:5432/th
# 32+ karakter, véletlen; SMTP jelszavak titkosításához és HMAC-hez
APP_SECRET=change-me-change-me-change-me-change-me
PHOTO_DIR=./data/photos

# --- Google Maps Platform (térkép, geokódolás, útvonal) ---
# Böngészőkulcs (Maps JavaScript API + Directions): Cloud Console-ban korlátozd HTTP referrer szerint a saját domainedre.
GOOGLE_MAPS_API_KEY=
# Vektoros/haladó markerekhez kötelező map ID (Cloud Console -> Map Management); fejlesztéshez a DEMO_MAP_ID is jó.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Szerverkulcs (Geocoding API): korlátozd a szerver IP-címére. Üresen a Nominatim (OSM) a geokódoló.
GOOGLE_GEOCODING_API_KEY=
# Havi plafon a Google geokódolási hívásokra; elérése után automatikusan a Nominatim tartalék működik.
GOOGLE_GEOCODING_MONTHLY_LIMIT=1000
